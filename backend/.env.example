# Backend Environment Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.your-ref:your-password@db.your-ref.supabase.co:5432/postgres

# Supabase API & Storage Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=complaint-images

# Security & Authentication
JWT_SECRET=your-production-jwt-secret-key-change-me

# Resend Email Service (HTTPS REST API)
EMAIL_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=EduFix AI <onboarding@resend.dev>
