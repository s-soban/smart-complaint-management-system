# ====================================================
# SMART COMPLAINT MANAGEMENT SYSTEM (EDUFIX AI)
# ENVIRONMENT CONFIGURATION MATRIX
# ====================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction/Session Pooler: postgresql://postgres.your-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-ref:your-password@db.your-ref.supabase.co:5432/postgres

# Supabase API & Storage Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=complaint-images

# Security & Authentication
JWT_SECRET=your-production-jwt-secret-key-change-me

# Resend Email Service (HTTPS REST API)
EMAIL_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=EduFix AI <onboarding@resend.dev>

# ====================================================
# FRONTEND CONFIGURATION (For Frontend Render Service)
# ====================================================
# VITE_API_URL=https://your-backend-app.onrender.com/api
